# .gitignore for Cinematic Thoughtcast: AI Titans

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.env

# Large raw footage & heavy media binaries (4K lossless PNGs >2.5MBx14 & external MOVs in Google Drive; MP4 archives & Flow pre-vis synced to GitHub)
05_RAW_FOOTAGE/veo_clips/*.mp4
05_RAW_FOOTAGE/veo_clips/*.mov
05_RAW_FOOTAGE/flow_renders/*.mov
05_RAW_FOOTAGE/dossiers_press/*.png
05_RAW_FOOTAGE/speaker_portraits/*.jpg
05_RAW_FOOTAGE/speaker_portraits/*.png

# DaVinci Resolve cache & projects autosaves
*.gallery
*.dtl
.davinci/
CacheClip/
.gallery/

# Heavy Audio Stems & SFX (mirrored to Google Drive, excluded from Git)
03_AUDIO/**/*.wav
03_AUDIO/*.wav

# Local Backups
09_BACKUPS/*.tar.gz
09_BACKUPS/*.zip
09_BACKUPS/*.bak
